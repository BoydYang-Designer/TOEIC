[
  {
    "id": "d1-002-e",
    "domain": "d1",
    "qtype": "q1",
    "wh": "where",
    "tag": "詢問檔案該放哪裡",
    "scene": "office",
    "level": {
      "score": 500,
      "cefr": "A2+",
      "tier": "easy",
      "why": "Where 問句短而單純，正解都直接說出地點。"
    },
    "q": {
      "t": "Where should I put these files?",
      "zh": "我該把這些檔案放在哪裡?"
    },
    "pool": [
      {
        "t": "On my desk, please.",
        "zh": "請放在我的桌上。",
        "ok": true,
        "trap": "correct",
        "pattern": "direct",
        "why": "正解：直接說出放置地點。"
      },
      {
        "t": "In the top drawer.",
        "zh": "在最上面的抽屜。",
        "ok": true,
        "trap": "correct",
        "pattern": "direct",
        "why": "正解：直接指出抽屜位置。"
      },
      {
        "t": "Next to the printer.",
        "zh": "在印表機旁邊。",
        "ok": true,
        "trap": "correct",
        "pattern": "direct",
        "why": "正解：用相對位置回答地點。"
      },
      {
        "t": "At three o'clock.",
        "zh": "在三點。",
        "ok": false,
        "trap": "wrong-wh",
        "why": "這是回答 When 的答案。"
      },
      {
        "t": "Mr. Brown from sales.",
        "zh": "業務部的布朗先生。",
        "ok": false,
        "trap": "wrong-wh",
        "why": "這是回答 Who 的答案。"
      },
      {
        "t": "Put your phone away, please.",
        "zh": "請把你的手機收起來。",
        "ok": false,
        "trap": "word-repeat",
        "why": "重複 put，但不是回答地點。"
      },
      {
        "t": "I filed these last week.",
        "zh": "我上週歸檔了這些。",
        "ok": false,
        "trap": "word-repeat",
        "why": "filed 與 files 同字根，卻沒有回答地點。"
      },
      {
        "t": "I wear a jacket at work.",
        "zh": "我上班會穿外套。",
        "ok": false,
        "trap": "sound-alike",
        "why": "wear 與 where 音近，意思無關。"
      },
      {
        "t": "Those files look very old.",
        "zh": "那些檔案看起來很舊。",
        "ok": false,
        "trap": "association",
        "why": "談檔案，但沒有說放哪裡。"
      },
      {
        "t": "I need these files for a meeting.",
        "zh": "我開會需要這些檔案。",
        "ok": false,
        "trap": "association",
        "why": "與檔案有關，但沒有回答地點。"
      },
      {
        "t": "She put them away yesterday.",
        "zh": "她昨天把它們收起來了。",
        "ok": false,
        "trap": "wrong-tense-person",
        "why": "人稱與時態不符，也沒有給出地點。"
      },
      {
        "t": "He was sending the files.",
        "zh": "他當時正在寄檔案。",
        "ok": false,
        "trap": "wrong-tense-person",
        "why": "人稱與時態不符，沒有回答地點。"
      }
    ],
