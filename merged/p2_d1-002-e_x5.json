  {
    "id": "d1-003-e",
    "domain": "d1",
    "qtype": "q3",
    "tag": "詢問週一或週二開會",
    "scene": "office",
    "level": {
      "score": 550,
      "cefr": "A2+",
      "tier": "easy",
      "why": "二選一問句，正解直接選一個或表示都可以。"
    },
    "q": {
      "t": "Should we meet on Monday or Tuesday?",
      "zh": "我們該週一還是週二開會?"
    },
    "pool": [
      {
        "t": "Monday works for me.",
        "zh": "週一我可以。",
        "ok": true,
        "trap": "correct",
        "pattern": "pick-one",
        "why": "正解：直接選擇週一。"
      },
      {
        "t": "Let's meet on Tuesday.",
        "zh": "我們週二見吧。",
        "ok": true,
        "trap": "correct",
        "pattern": "pick-one",
        "why": "正解：直接選擇週二。"
      },
      {
        "t": "Either day is fine.",
        "zh": "哪一天都可以。",
        "ok": true,
        "trap": "correct",
        "pattern": "no-preference",
        "why": "正解：表示兩天都行。"
      },
      {
        "t": "In the conference room.",
        "zh": "在會議室。",
        "ok": false,
        "trap": "wrong-wh",
        "why": "這是回答 Where 的答案。"
      },
      {
        "t": "Yes, we should.",
        "zh": "是的，我們應該。",
        "ok": false,
        "trap": "wrong-wh",
        "why": "選擇問句不能用 Yes 回答。"
      },
      {
        "t": "It was nice to meet you.",
        "zh": "很高興認識你。",
        "ok": false,
        "trap": "word-repeat",
        "why": "重複 meet，但意思是初次見面問候。"
      },
      {
        "t": "Please meet me in the lobby.",
        "zh": "請在大廳跟我碰面。",
        "ok": false,
        "trap": "word-repeat",
        "why": "重複 meet，但沒有選擇日期。"
      },
      {
        "t": "No meat for me, thanks.",
        "zh": "我不吃肉，謝謝。",
        "ok": false,
        "trap": "sound-alike",
        "why": "meat 與 meet 音近，意思無關。"
      },
      {
        "t": "The weekend was really relaxing.",
        "zh": "週末過得很放鬆。",
        "ok": false,
        "trap": "association",
        "why": "談日子，但沒有回答選擇。"
      },
      {
        "t": "Our team has six members.",
        "zh": "我們團隊有六個人。",
        "ok": false,
        "trap": "association",
        "why": "與開會的人有關，但沒有回答。"
      },
      {
        "t": "They met on Tuesday.",
        "zh": "他們週二見過面了。",
        "ok": false,
        "trap": "wrong-tense-person",
        "why": "人稱與時態不符，是過去的事。"
      },
      {
        "t": "He was meeting a client yesterday.",
        "zh": "他昨天在見客戶。",
        "ok": false,
        "trap": "wrong-tense-person",
        "why": "人稱與時態不符，沒有回答問題。"
      }
    ],
    "vocab": [
      {
